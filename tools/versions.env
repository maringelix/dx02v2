# Harness tool versions (verified 2026-10-11).
# Change a version only with scripts/update-tool-checksums.sh <tool> <version>,
# which also rewrites tools/checksums.txt. See docs/MAINTENANCE.md.
# kubectl follows the Kubernetes minor of the kind node image (kind/kind-config.yaml) and of the
# AKS cluster in tx02v2 (1.36). kubelogin turns the kubeconfig of `az aks get-credentials` into the
# Azure CLI login method (AKS with local accounts disabled, scripts/deploy-azure.sh).
TRIVY_VERSION=0.75.0
HADOLINT_VERSION=2.15.1
ACTIONLINT_VERSION=1.7.12
SHELLCHECK_VERSION=0.11.0
KUBECONFORM_VERSION=0.8.0
GITLEAKS_VERSION=8.30.1
KIND_VERSION=0.33.0
KUBECTL_VERSION=1.36.5
KUBELOGIN_VERSION=0.2.21
# promtool from the Prometheus release (same version as the local platform's Prometheus).
PROMTOOL_VERSION=3.15.0
