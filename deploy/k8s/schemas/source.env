# Source of the generated JSON schemas in this directory (scripts/update-crd-schemas.sh; never edit
# the .json files by hand). The ALB Controller of Application Gateway for Containers installs these
# CRDs with the init container of its Helm chart: alb.networking.azure.io v1 and the Gateway API
# bundle v1.5.1, standard channel (verified 2026-10-11). Keep the version equal to the ALB
# Controller that the tx02v2 platform layer installs.
ALB_CONTROLLER_VERSION=1.12.2
ALB_CRDS_INDEX_DIGEST=sha256:f5e1761155222b58802865cdf3746a915eeb798890ce931e28576684e1032f06
# The full profile and local waypoint install this later Gateway API bundle. Keep the ALB schemas
# above for core/edge, and validate full-profile routes against this exact experimental asset.
GATEWAY_CRDS_VERSION=v1.6.3
GATEWAY_CRDS_EXPERIMENTAL_SHA256=72f549ff57416e2e1085c5be1718f5f86108aa75ac39b4bc27c1c7aef1497127
