# Deploy-time values for the azure overlays (KEY=VALUE, no quotes). scripts/deploy-azure.sh writes
# the real params.env from the App Configuration keys tx02v2/lab/* (docs/CONTRACT.md) into a temporary
# copy of deploy/k8s; CI renders and validates the overlays with this example file. Placeholders
# only: the all-zero subscription GUID, registry suffix and commit SHA, and documentation CIDRs.
API_IMAGE=tx02v2lab00000000.azurecr.io/dx02v2/api:0000000000000000000000000000000000000000
MESH_IMAGE=tx02v2lab00000000.azurecr.io/dx02v2/api:0000000000000000000000000000000000000000
WEB_IMAGE=tx02v2lab00000000.azurecr.io/dx02v2/web:0000000000000000000000000000000000000000
AGC_ID=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/tx02v2-lab/providers/Microsoft.ServiceNetworking/trafficControllers/tx02v2-lab-agc
AGC_FRONTEND=tx02v2-lab-frontend
DNS_HOSTNAME=lab.example.com
WAF_POLICY_ID=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/tx02v2-lab/providers/Microsoft.Network/applicationGatewayWebApplicationFirewallPolicies/tx02v2-lab-waf
AGC_SUBNET_CIDR=10.42.2.0/24
POSTGRES_SUBNET_CIDR=10.42.3.0/24
DB_SECRET_NAME=tx02v2-lab-db-app
ADMIN_TOKEN_SECRET_NAME=tx02v2-lab-app-admin-token
